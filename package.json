{
  "name": "naia-stylist",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "postinstall": "prisma generate",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "generate:lenses": "tsx scripts/generate-lenses.ts",
    "test:dashboard": "node --test --import tsx/esm app/lib/designer-sample-data.validation.test.ts app/lib/ai/canonical-reconciliation.test.ts app/lib/ai/batch1-integration.test.ts app/lib/ai/batch2-integration.test.ts",
    "test:customer": "node --test --import tsx/esm app/routes/customer-routes.test.ts app/routes/customer-loaders.test.ts app/lib/ai/selfie-upload.test.ts",
    "test:security": "npx vitest run app/routes/api.seed-staging.test.ts app/routes/naia-identity-security.test.ts",
    "test": "node --test --import tsx/esm app/lib/designer-sample-data.validation.test.ts app/lib/ai/canonical-reconciliation.test.ts app/lib/ai/batch1-integration.test.ts app/lib/ai/batch2-integration.test.ts app/lib/ai/styleme-recommendation.test.ts app/lib/ai/closet-insights.test.ts app/routes/customer-routes.test.ts app/routes/customer-loaders.test.ts app/lib/ai/selfie-upload.test.ts app/lib/passport/v2-b1-helpers.test.ts app/routes/passport.test.ts app/lib/passport/v2-b2.test.ts app/lib/passport/v2-c.test.ts app/lib/passport/v2-d.test.ts app/lib/passport/v2-e.test.ts app/lib/passport/v2-f.test.ts app/lib/passport/v2-qa.test.ts app/routes/api.trigger-tryon.test.ts app/routes/buyskip-s0.test.ts app/lib/image-moderation.test.ts app/lib/image-suitability.test.ts app/routes/closet-image-security.test.ts app/routes/api-wishlist-moderation.test.ts app/routes/my-naia-model-moderation.test.ts app/routes/selfie-moderation.test.ts && npm run test:security"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^8.0.0",
    "@vercel/react-router": "^1.2.6",
    "canvas": "^3.2.3",
    "isbot": "^5.1.31",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "openai": "^6.33.0",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "nadeenabuobead"
}

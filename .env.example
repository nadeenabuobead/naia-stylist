# .env.example — nAia Stylist environment variable reference
#
# Phase 2 ops deliverable. Names, descriptions, required/optional status,
# and environment applicability ONLY — every value below is empty or a
# placeholder shape (e.g. "sk_test_..."), never a real credential. This
# file is safe to commit.
#
# Environment legend:
#   Dev      = local development machine
#   Preview  = Vercel Preview deployments (this project's staging lineage)
#   Prod     = Vercel Production
#
# "Required" means the app/build fails or a specific feature is silently
# broken without it — not that every environment needs every required
# var (e.g. staging-only secrets are "Required" wherever that feature is
# exercised, "N/A" elsewhere). Where this session could not determine the
# exact behavior with certainty from reading the code, that's stated
# explicitly rather than guessed.


# ── Core runtime ──────────────────────────────────────────────────────────────

# Standard Node environment flag. Usually set automatically by the
# platform/tooling, not by hand.
# Required: No (has a safe default) | Environments: Dev, Preview, Prod
NODE_ENV=

# Signs Remix/React Router session cookies. Losing or rotating this value
# invalidates every existing session.
# Required: Yes | Environments: Dev, Preview, Prod
SESSION_SECRET=

# Legacy pre-Clerk customer session signing secret (still referenced by
# naia-session.server.ts-adjacent code paths at the time of this audit).
# Required: Yes, wherever the legacy Shopify-OAuth session path is still
# reachable | Environments: Dev, Preview, Prod
NAIA_CUSTOMER_SECRET=


# ── Database (Prisma / Postgres) ─────────────────────────────────────────────

# Pooled connection string — what the running app actually queries through
# (app/db.server.js adds connection_limit=2). schema.prisma's datasource
# `url` resolves from this.
# Required: Yes | Environments: Dev, Preview, Prod
NAIA_DATABASE_URL=

# Direct (unpooled) connection string. schema.prisma's `directUrl` (used
# by the Prisma CLI for migrate/introspect) resolves from this; a few
# one-off ops/QA scripts under scripts/ also read it directly.
# Required: Yes | Environments: Dev, Preview, Prod
DATABASE_URL=

# Alternate direct-connection URL some one-off scripts
# (scripts/phase3c-qa-export.mts, scripts/probe-*.mjs) fall back to if
# DIRECT_URL/DATABASE_URL aren't set — looks like a Vercel Postgres
# integration auto-provided variable name, not something this app's own
# runtime code reads.
# Required: No (script-convenience fallback only) | Environments: Dev
DATABASE_POSTGRES_URL=

# Read by a couple of standalone scripts (query-all-shopify-media.ts,
# resolve-component-urls.ts, wardrobe-intelligence-qa.mts) as a direct
# connection string, independent of the app's own schema.prisma binding.
# Required: No (script-only) | Environments: Dev
DIRECT_URL=

# Local/CI test-database configuration — not used by the deployed app at
# all.
# Required: No | Environments: Dev only
TEST_DATABASE_URL=
TEST_DB_DIR=
TEST_DB_PORT=

# Preview-build migration control. Deliberately defaults to "skip" —
# scripts/build-preview.sh only runs `prisma migrate deploy` when this is
# exactly "true". See docs/runbooks/backup-restore-dr.md and this phase's
# own preview-protection design doc for why this exists.
# Required: No (default is correct/safe) | Environments: Preview only
NAIA_ALLOW_PREVIEW_MIGRATIONS=


# ── Shopify app ───────────────────────────────────────────────────────────────

# Required: Yes | Environments: Dev, Preview, Prod
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=

# Required: Yes, wherever Shopify storefront/customer-OAuth paths are
# exercised | Environments: Dev, Preview, Prod
SHOPIFY_STORE_DOMAIN=
SHOP_CUSTOM_DOMAIN=
STOREFRONT_HOST=


# ── Clerk (customer auth) — owned by the Stripe/Clerk workstream ────────────
# Listed for completeness; do not change these without coordinating with
# that workstream.

# Required: Yes, wherever Clerk auth is live | Environments: Preview, Prod
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SECRET=


# ── Stripe (billing) — owned by the Stripe/Clerk workstream ─────────────────
# Listed for completeness; do not change these without coordinating with
# that workstream. Code hard-refuses any key not starting "sk_test_" via
# assertTestModeKey — going live is a deliberate, separate decision.

# Required: Yes, wherever billing is live | Environments: Preview, Prod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ── AI providers ──────────────────────────────────────────────────────────────

# Required: Yes | Environments: Dev, Preview, Prod
ANTHROPIC_API_KEY=

# Optional override of the default Claude model string.
# Required: No | Environments: Dev, Preview, Prod
CLAUDE_MODEL=

# Required: Yes, for virtual try-on | Environments: Dev, Preview, Prod
FASHN_API_KEY=

# Required: Yes, for the body-scan/measurements feature | Environments: Dev, Preview, Prod
BODYGRAM_API_KEY=
BODYGRAM_ORG_ID=


# ── Cloudinary (image storage) — coordinate with the Cloudinary Privacy workstream ──

# Required: Yes | Environments: Dev, Preview, Prod
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WARDROBE_UPLOAD_PRESET=

# Feature flag gating live EXIF/GPS metadata stripping.
# Required: No | Environments: Preview, Prod
CLOUDINARY_METADATA_STRIP_LIVE=


# ── Transactional email (Resend) ─────────────────────────────────────────────
# As of this audit, wired for exactly one purpose: identity-linking
# verification codes (app/lib/email/resend-email.server.ts). No live key
# is configured anywhere yet — sending fails loudly, by design, if unset.

# Corrected (previously said "not yet configured anywhere" — that was
# wrong). A prior session's live `vercel env ls --environment=preview`
# check against naia-stylist-staging (2026-11-11) confirmed this IS
# present in that project's Preview environment scope — not re-verified
# live by this session (no Vercel CLI/dashboard access this pass), so
# treat "present in Preview" as last-confirmed 2026-11-11, not
# continuously current. Production scope was not checked either session.
# Required: Yes, wherever identity-linking email is live
# Environments: Preview (confirmed present on naia-stylist-staging as of
# 2026-11-11) — Production presence unconfirmed either way
RESEND_API_KEY=

# Has a code-level default (verify@naiabynadine.com) — only needs setting
# to override it.
# Required: No | Environments: Preview, Prod
RESEND_VERIFICATION_FROM_ADDRESS=


# ── Internal / admin auth ────────────────────────────────────────────────────

# Required: Yes, wherever the internal admin surface is reachable
# Environments: Dev, Preview, Prod
INTERNAL_ADMIN_SECRET=
INTERNAL_ADMIN_COOKIE_SECRET=
INTERNAL_ADMIN_IDENTITY_EMAIL=

# Allow-list style access controls — optional, narrows admin access
# further when set.
# Required: No | Environments: Preview, Prod
NAIA_ADMIN_ALLOWED_EMAILS=
NAIA_ADMIN_ALLOWED_SHOPS=
NAIA_ADMIN_REQUIRE_ACCOUNT_OWNER=

# Designer Intelligence dashboard — same access-control pattern as above,
# separate surface.
# Required: No | Environments: Preview, Prod
DESIGNER_INTELLIGENCE_ALLOWED_EMAILS=
DESIGNER_INTELLIGENCE_ALLOWED_SHOPS=
DESIGNER_INTELLIGENCE_REQUIRE_ACCOUNT_OWNER=
DESIGNER_SAMPLE_DATA_ENABLED=

# Required: Yes, for the Designer Preview staging route specifically
# Environments: Preview (staging) only
DESIGNER_PREVIEW_SECRET=


# ── Staging-only diagnostics & QA (must be ABSENT on Production) ───────────
# Every route gated by NAIA_PROJECT_VARIANT checks for the literal string
# "staging" and 404s otherwise — confirmed, via this and prior audits,
# that none of these are set on the real production Vercel project.

# Required: Yes, on the staging project only | Environments: Preview
# (staging project) only — must NOT be set on Production
NAIA_PROJECT_VARIANT=
STAGING_SEED_SECRET=
STAGING_FIX_SECRET=
WI_QA_LOGIN_SECRET=

# Required: No, feature not yet active (the GitHub Actions workflow that
# would use it isn't merged to main yet — see this phase's alerting
# design doc) | Environments: Preview (staging) only, once activated
FULL_LOOK_VTO_SWEEP_SECRET=

# Vercel Cron's own Authorization: Bearer <value> convention — an
# alternate way to authorize the same sweep endpoint above.
# Required: No (alternate auth path, not yet in active use)
# Environments: Preview (staging) only, if/when Vercel Cron is used
CRON_SECRET=

# Scopes which synthetic customer IDs the Full-Look VTO real-provider test
# sweep is allowed to touch.
# Required: No | Environments: Preview (staging) only
FULL_LOOK_VTO_REAL_TEST_SCOPE=
FULL_LOOK_VTO_TEST_CUSTOMER_IDS=

# Fixture values for one narrow FASHN dev-preflight script
# (scripts/dev-preflight.ts) — not read by the deployed app itself.
# Required: No | Environments: Dev only
DEV_TEST_MODEL_IMAGE_PUBLIC_ID=
DEV_TEST_MODEL_FORMAT=
DEV_TEST_MODEL_DELIVERY_TYPE=


# ── Feature flags / tuning (all optional — safe defaults if unset) ─────────

# Required: No | Environments: Dev, Preview, Prod
ENTITLEMENT_ENFORCEMENT=
DEV_TRYON_UI_ENABLED=
VTO_UI_ENABLED=
NAIA_STYLEME_DIAGNOSTICS=
STYLEME_MONTHLY_LIMIT_OVERRIDE=
VTO_MONTHLY_LIMIT_OVERRIDE=
STYLEME_QA_EXPORT_ENABLED=
WARDROBE_V2_INTENTIONS=
CANONICAL_STYLEME_COLOUR=
CANONICAL_STYLEME_FORMALITY=
CANONICAL_STYLEME_LENGTH=
CANONICAL_STYLEME_OCCASIONS=


# ── Platform-injected (do not set manually) ─────────────────────────────────
# Vercel sets these itself on every deployment. Listed only so their
# presence in code isn't mistaken for a var someone forgot to configure.

# Required: N/A (set automatically by Vercel) | Environments: Preview, Prod
# VERCEL_ENV=
# VERCEL_URL=


# ── Not included above, deliberately ────────────────────────────────────────
# CLD_API_KEY / CLD_API_SECRET / CLD_CLOUD_NAME / CLD_PRESET are read only
# by scripts/run-live-metadata-validation.sh, a script its own header
# comment says is "Run this yourself, in your own terminal... never
# executed by Claude" — a manual, human-run-only diagnostic, not a
# standing deployment environment variable. Not listed as an app env var
# to avoid implying it needs to be set in any Vercel environment.

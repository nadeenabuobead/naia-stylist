{{ 'naia-product-block.css' | asset_url | stylesheet_tag }}

<div
  id="naia-product-block"
  data-product-id="{{ product.id }}"
  data-app-url="{{ block.settings.app_url }}"
></div>

<script src="{{ 'naia-product-block.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "nAia Product Intelligence",
  "target": "section",
  "settings": [
    {
      "type": "url",
      "id": "app_url",
      "label": "nAia App URL",
      "info": "The nAia Stylist app base URL. Do not change unless instructed."
    }
  ]
}
{% endschema %}

  favorite    Boolean  @default(false)
  
  // AI Analysis (legacy)
  aiDescription String?      // AI-generated description
  aiStyleNotes  String?      // AI notes about styling this piece

  // Garment Intelligence — Group 3B (migration 20260828000000_closet_garment_intelligence)
  analysisStatus        String    @default("not_analyzed") // not_analyzed | pending | ready | failed
  analyzedAt            DateTime?
  analysisSchemaVersion String?
  // Tier 2 — observable attributes (Group 2 dressing vocab reused for coverage fields)
  silhouette            String?   // GarmentSilhouette token
  fitProfile            String?   // FitProfile token (Group 2 vocab)
  hemLength             String?   // HemLength token (Group 2 vocab); "n/a" for tops
  topLength             String?   // TopLength token (Group 2 vocab); "n/a" for bottoms/dresses
  sleeveLength          String?   // SleeveLength token (Group 2 vocab); "n/a" when not applicable
  necklineCoverage      String?   // NecklineCoverage token (Group 2 vocab); null if not visible
  shoulderCoverage      Boolean?
  midriffExposed        Boolean?
  waistShape            String?   // GarmentWaistShape token
  // Tier 3 — matching signals (all vocabulary-normalized; never raw AI strings)
  formality             String?   // GarmentFormality token
  stylePersonality      String?   // single V3 archetype token or null
  fieldConfidence       Json?     // GarmentFieldConfidence partial record

  // Try-On Eligibility (Phase 4A6 — migration 20260717000000)
  tryOnEligibility  String?   // ready-for-try-on | needs-clearer-photo | not-supported | pending-assessment | null
  tryOnAssessedAt   DateTime?
  tryOnCustomerHint String?
  tryOnInternalNote String?

  // Garment Relationship — First nAia Read group (migration 20260830000000)
  // Customer-stated relationship to this piece (not inferred by AI).
  // Multi-select, max 2. See GARMENT_RELATIONSHIP_IDS in first-naia-read.ts.
  garmentRelationships  String[]  @default([])

  // Customer note — optional free-text signal (migration 20260904000000)
  // Anything the customer wants nAia to know: fit quirks, wear context, styling notes.
  customerNote          String?

  // ── Photo consent (2026-10-19) ─────────────────────────────────────────────
  //
  // Priority 5: Closet upload/analysis previously had NO consent gate at all.
  // Fields only for now — NOT yet enforced in api.closet-preview-analyze.ts
  // or api.closet.jsx. See photo-consent.server.ts for why (enforcing here
  // without a matching UI change in closet._index.tsx — a very large,
  // actively-used component — would just reject every real upload).
  photoConsentAt      DateTime?
  photoConsentVersion String?

  // Relationships
  outfitItems   OutfitItem[]
  savedLookItems         SavedLookItem[]
  recommendationFeedback RecommendationFeedback[]
  analysisSnapshots      ClosetItemAnalysisSnapshot[]
  adminReview            ClosetItemAdminReview?
  styleMeProfile         GarmentStyleMeProfile?
}

enum ClosetCategory {
  TOPS
  BOTTOMS
  DRESSES
  OUTERWEAR
  SHOES
  BAGS
  ACCESSORIES
  JEWELRY
  ACTIVEWEAR
  SWIMWEAR
  LOUNGEWEAR
  OTHER
}

// ============================================
// STYLE ME (Main Styling Feature)
// ============================================

model StylingSession {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  // Continuation lineage — set when this session was started via Adjust Vibe.
  // null = root StyleMe (counts toward quota).
  // non-null = continuation of parentSessionId (does NOT count toward quota).
  // Historical sessions pre-dating this field default to null; they cannot
  // be reliably distinguished from roots. New Adjust Vibe sessions are linked correctly.
  parentSessionId String?
  parentSession   StylingSession?  @relation("SessionContinuation", fields: [parentSessionId], references: [id], onDelete: SetNull)
  continuations   StylingSession[] @relation("SessionContinuation")

  // Input Context
  currentMood     String?   // How she's feeling now
  desiredFeeling  String?   // How she wants to feel
  occasion        String?   // Where she's going
  bodyNeeds       String[]  @default([])  // Normalized body-need IDs from comfort step
  formalityConditional String?  // Conditional formality answer from occasion step (nullable — not all occasions show it)
  practicalIds    String[]  @default([])  // Practical-today signal IDs from comfort step
  specificNeeds   String?   // Any specific requirements
  bodyPreference  String?   // Body fit preferences
  styleDNA        String?   // Style DNA preferences (JSON array)

  // Rev 3 — Psychology-First StyleMe (Group 5)
  state           String?        // Rev 3 state answer ID (wording context only)
  intentions      String[]  @default([])  // Rev 3 intention answer IDs (up to 2)

  // Source Selection
  styleFrom       StyleSource @default(BOTH)
  closetAnchorId  String?     // ClosetItem ID selected for CLOSET/BOTH sources; null for NAIA
  anchorProvenance AnchorProvenance?  // null = historical, treated as MANUAL

  // Weather/Context
  weather         String?
  timeOfDay       String?   // morning, afternoon, evening

  // Product context this session was generated in: "naia" (closet-only) or "nadine"
  // (closet + eligible NADINE pieces). Nullable because every row written before this
  // column existed has none — resolveStyleMeMode falls back to the cookie, then to "naia".
  // Persisted because the cookie is a statement about a browser, not about the session:
  // once it expired, a NADINE session silently became an nAia one on reload.
  styleMeMode     String?

  // Output
  suggestions     OutfitSuggestion[]

  // Selected Suggestion
  selectedSuggestionId String?

  // Follow-up
  review          PostOutfitReview?
  events                 StylingEvent[]
  recommendationFeedback RecommendationFeedback[]
  adminReview            StylingSessionAdminReview?

  // Formalizes an index 20260905100000_plan_entitlement already creates on
  // this FK column — the migration had it right; schema.prisma was just
  // missing the matching declaration.
  @@index([parentSessionId])
}

enum StyleSource {
  CLOSET      // Only from her wardrobe
  NAIA        // Only from nAia store
  BOTH        // Mix of both
}

// Who chose the anchor garment. Decides whether "New Look, Same Vibe" may move the
// structural centre of the outfit: nAia's own pick is a starting point, the customer's is
// part of the brief. Nullable — historical rows predate this and are read as MANUAL, the
// conservative default, because silently replacing a garment she chose is the worse failure.
enum AnchorProvenance {
  AUTO        // autoSelectClosetAnchor picked it ("nAia chooses")
  MANUAL      // the customer picked it (Style This Piece / manual closet selection)
}

model OutfitSuggestion {

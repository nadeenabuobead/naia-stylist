  editorialIntro     String
  naiaTake           String?
  naiaInterpretation String?
  naiaVerdict        String?
  wardrobeNote       String?
  investmentNotes    String?

  keyTrends                Json @default("[]")
  rising                   Json @default("[]")
  fading                   Json @default("[]")
  referencesBehindThisEdit Json @default("[]")
  howToWear                Json @default("[]")
  sources                  Json @default("[]")
  spendSaveSkip            Json @default("{}")

  visualTreatment String?

  @@map("editorial_trend_reports")
}

/// Personalised Trend Edit — customer entitlement/usage truth (1/month).
/// reportSlug is a historical string identity, not a FK to EditorialTrendReport:
/// an editorial report may later be edited or archived, but the fact that this
/// customer consumed one completed personalised edit of it in this period must
/// stay valid regardless of what happens to the editorial row afterward.
/// This is a distinct source of truth from JourneyEvent (analytics only, hashed
/// customerId, not queryable per-customer) — Plan & Usage and quota checks read
/// only this model, never JourneyEvent.
model PersonalisedTrendEditUsage {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reportSlug String
  /// UTC "YYYY-MM", derived from the same authority as getUsageWindow() —
  /// exists for the idempotency constraint below; monthly counting itself
  /// still queries createdAt, matching every sibling usage check.
  periodKey  String
  createdAt  DateTime @default(now())

  /// Additive, nullable — the exact customer-facing generated edit content,
  /// captured once at first generation this period (trends.my-edits.$slug.tsx).
  /// Null for every row written before this field existed and for rows
  /// written before a future generation path populates it; never
  /// backfilled/reconstructed, since the inputs that produced historical
  /// content (Passport/Closet state at that moment) are not preserved
  /// anywhere. Shape owned by the write path — see TrendEditSnapshot in
  /// personalised-trend-edit-usage.server.ts.
  snapshot   Json?

  @@unique([customerId, reportSlug, periodKey])
  @@index([customerId, createdAt])
}


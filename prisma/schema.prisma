// prisma/schema.prisma
// nAia Style Intelligence Platform - Complete Database Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // NAIA_DATABASE_URL: the freshly-created Prisma Postgres POOLED
  // connection string — used by Prisma Client (app/db.server.js) for all
  // application traffic.
  // DATABASE_URL: the pre-existing, Vercel/Prisma-managed DIRECT
  // connection (resolves to db.prisma.io, not the pooled host) — reused
  // here as directUrl for the Prisma CLI only (migrate, introspect,
  // studio, db pull). Application code never reads this field's value;
  // only the Prisma CLI does.
  url       = env("NAIA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}
// ============================================
// SHOPIFY SESSION (Required for Shopify App)
// ============================================

model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String?
  userId      BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?  @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ============================================
// INTERNAL ADMIN PORTAL — LOGIN RATE LIMITING
// ============================================

/// Priority 5 (2026-10-19) — the internal admin portal (app/lib/internal-auth.server.ts)
/// is a single shared static password with no durable brute-force protection
/// (previously just a fixed 350ms delay on failure, which a distributed or
/// patient attacker simply waits out). This table makes lockout durable
/// across serverless invocations, which in-memory counting cannot do.
///
/// ipHash is a SHA-256 digest of the client IP — never the raw address,
/// matching the JourneyEvent.customerIdHash pattern already used elsewhere.
/// Rows age out of relevance after RATE_LIMIT_WINDOW_MS (see
/// admin-login-rate-limit.server.ts) and are opportunistically pruned on
/// each write — there is no separate retention job for this table.
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum MembershipStatus {
  NONE
  MEMBER
}

model Customer {
  id                String           @id @default(cuid())
  // Nullable as of the Clerk migration (2026-11-04) — a customer created
  // through Clerk never goes through Shopify OAuth and so never gets one.
  // Every row created before this migration already has a value; nothing
  // backfills this to null retroactively.
  shopifyCustomerId String?          @unique
  // Nullable until a Customer either signs up fresh through Clerk or an
  // existing (pre-Clerk) row completes the verified identity-linking flow —
  // see IdentityLinkRequest. A Customer can exist with EITHER id populated,
  // BOTH (a linked legacy account), or (transiently, mid-migration) neither
  // on a pre-Clerk row that hasn't signed in since the cutover yet.
  clerkUserId       String?          @unique
  // Cumulative, cross-request brute-force guard for the identity-linking
  // flow — see IdentityLinkRequest and identity-linking.server.ts's own
  // comment on why a per-request attemptCount alone is insufficient (a
  // new attacker-controlled clerkUserId resets that counter to 0 on every
  // disposable Clerk sign-up). Lives on Customer, the actual target, not
  // on any one (deletable) request row, so it survives across every
  // distinct clerkUserId that has ever attempted this customer's code.
  identityLinkFailedAttempts Int       @default(0)
  identityLinkLockedUntil    DateTime?
  email             String?          @unique
  firstName         String?
  lastName          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  membershipStatus  MembershipStatus @default(NONE)

  // Relationships
  onboardingProfile   OnboardingProfile?
  closetItems         ClosetItem[]
  stylingSessions     StylingSession[]
  buyOrSkipAnalyses   BuyOrSkipAnalysis[]
  wardrobeInsights    WardrobeInsight[]
  savedLooks          SavedLook[]
  postOutfitReviews   PostOutfitReview[]
  confidenceScores    ConfidenceScore[]
  trendReportViews    TrendReportView[]
  stylingEvents       StylingEvent[]
  sessions               NaiaSession[]
  naiaModel              NaiaModel?
  tryOnJobs              VirtualTryOnJob[]
  recommendationFeedback RecommendationFeedback[]
  selfieAnalysis         SelfieAnalysis?
  naiaObservationFeedback NaiaObservationFeedback[]
  styleMemoryOutcomes     StyleMeOutcome[]
  tasteEvidence           TasteEvidence[]
  styleTendencies         StyleTendency[]
  wardrobeSnapshots       WardrobeSnapshot[]
  personalisedTrendEditUsage PersonalisedTrendEditUsage[]
  // Billing — Phase 1 (schema only, no activation, no payment collection).
  // No new scalar field added to Customer itself: provider customer/
  // subscription identifiers live on Subscription/BillingTransaction, not
  // here. This is deliberate, not an oversight — see Subscription's own
  // comment for why.
  subscriptions       Subscription[]
  billingTransactions BillingTransaction[]
  disputes            Dispute[]

  // Clerk migration (2026-11-04) — pending, unconfirmed claims against this
  // row from a NEW Clerk identity whose sign-up email matched. See
  // IdentityLinkRequest's own comment for the full flow; this relation
  // exists only so a row can be queried for its own pending claims, it is
  // never read as "already linked" on its own.
  identityLinkRequests IdentityLinkRequest[]

  // ── Secondary use of this customer's data for NADINE design research ──────
  //
  // Opt-in only, and the default is no. Declining changes nothing about the
  // styling service. Aggregation filters on this at the QUERY layer, never by
  // hiding rows in a dashboard — see design-signal.server.ts.
  designResearchConsent        Boolean   @default(false)
  designResearchConsentAt      DateTime?
  /// Which wording was agreed to. A new version requires asking again.
  designResearchConsentVersion String?

  // ── Age declaration ────────────────────────────────────────────────────────
  //
  // Priority 5 (2026-10-19) — no mechanism anywhere in the app previously
  // confirmed a customer is above the minimum age. Fields only for now; NOT
  // yet wired into onboarding or any request path — see
  // age-confirmation.server.ts for why, and for the standalone, tested
  // check/record functions a UX decision can wire in once placement is
  // decided. Presence of ageConfirmedAt is the "yes" signal; absence is
  // simply "not asked/confirmed yet", same shape as designResearchConsentAt.
  ageConfirmedAt      DateTime?
  /// Which wording/minimum-age policy was agreed to. A new version requires asking again.
  ageConfirmationVersion String?

  // ── Account type ──────────────────────────────────────────────────────────
  //
  // Our own test and demo accounts must never reach customer insight. Marked
  // on the record rather than filtered by email pattern, which silently breaks.
  accountType AccountType @default(CUSTOMER)
}

/// Real customers are the only accounts eligible for aggregated insight.
enum AccountType {
  CUSTOMER
  TEST
  DEMO
  QA
}

// ── Identity linking — Clerk migration (2026-11-04) ──────────────────────────
//
// A brand-new Clerk sign-up whose email matches an existing (pre-Clerk)
// Customer row is NEVER auto-attached to that row on email match alone —
// explicit product decision. This table is the pending, unconfirmed claim:
// it exists from the moment the collision is detected until the person
// either proves ownership of the matched row (a one-time code sent to the
// email already on file — not to whatever the new Clerk signup typed, since
// those are the same string here but the point is the code goes to the
// address this app already trusts) or abandons the claim.
//
// On confirmation: the resolver sets Customer.clerkUserId to this row's
// clerkUserId and deletes this row — see identity-linking.server.ts. Until
// then, the new Clerk identity has no Customer row of its own and cannot
// read or write any nAia data; it exists only to hold this one pending claim.
model IdentityLinkRequest {
  id         String  @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // The new Clerk identity asking to claim customerId. Unique — a given
  // Clerk user can have at most one open claim at a time; a second sign-up
  // attempt with the same collision reuses/replaces this row rather than
  // stacking a duplicate.
  clerkUserId String @unique

  // Snapshot of the email the collision was detected on, for audit purposes
  // only — Customer.email itself is the live value this flow is protecting.
  email String

  // SHA-256 of the one-time verification code. The raw code is never
  // persisted anywhere, same discipline as naia-session.server's tokenHash.
  codeHash     String
  attemptCount Int       @default(0)
  expiresAt    DateTime
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([customerId])
}

// ── Pending Clerk cleanup — account-deletion partial-failure recovery ───────
//
// settings.tsx's delete-account action erases nAia's own data FIRST, then
// deletes the Clerk user as a second, separate step — if that second step
// fails, the real PII-bearing erasure already succeeded, but a Clerk-hosted
// email/password would otherwise be left behind with nothing noticing. This
// row is that durable, operator-visible record: created on that specific
// failure, surfaced + retryable on /admin/maintenance (the same page the
// other no-cron manual-cleanup actions already live on), resolved once a
// retry actually succeeds.
//
// Deliberately NO foreign key to Customer: by the time this row is created,
// that Customer row is already erased — customerId here is a plain audit
// trail of which former account this orphaned credential belonged to, not
// a live reference.
model PendingClerkCleanup {
  id            String    @id @default(cuid())
  clerkUserId   String    @unique
  customerId    String
  lastError     String
  attemptCount  Int       @default(1)
  createdAt     DateTime  @default(now())
  lastAttemptAt DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([resolvedAt])
}

/// Durable, operator-visible record of a GDPR erasure (eraseCustomerData)
/// that hit a genuinely unexpected failure partway through — e.g. a DB error
/// during the anonymize-and-retain-financials path for a billed customer.
/// Deliberately NOT used for the two already-handled, expected cases: a
/// stuck Cloudinary asset (reported in EraseResult.cloudinaryFailures, not
/// here) and a customer with billing history (handled automatically by the
/// anonymize path, not a failure at all). Only one open row per customer —
/// a repeat failure updates it rather than stacking a duplicate, same
/// upsert convention as PendingClerkCleanup above. No FK to Customer: by the
/// time this runs, the customer's row may already be partially erased.
model PendingCustomerErasureFailure {
  id            String    @id @default(cuid())
  customerId    String    @unique
  /// Which caller triggered this — "shop/redact", "customers/redact", or
  /// "settings-self-service" — so an operator can tell a shop-uninstall
  /// sweep failure from an individual data-subject request failure.
  context       String
  lastError     String
  attemptCount  Int       @default(1)
  createdAt     DateTime  @default(now())
  lastAttemptAt DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([resolvedAt])
}

/// Two jobs in one, both load-bearing:
///   1. Durable, retryable record of a Cloudinary asset whose deletion
///      either failed (lastError set) or is being coordinated (see below).
///      Mirrors PendingClerkCleanup/PendingCustomerErasureFailure above —
///      same upsert-not-duplicate convention, same no-FK-to-Customer
///      reasoning (an abandoned upload's owning Customer may be anonymized
///      or deleted before this resolves; deleting a Cloudinary asset only
///      ever needs its publicId, never a live Customer row).
///   2. The reservation half of the abandoned-upload sweep's concurrency
///      protection: an UNRESOLVED row (resolvedAt: null) for a publicId
///      means "claimed for deletion — do not persist a new DB reference to
///      this asset." reserveClosetSlot/reserveBuySkipSlot (and the two
///      direct-create/-update paths that bypass them) check for an active
///      claim inside the SAME Serializable transaction that performs their
///      own count-recheck-then-create, exactly mirroring how those
///      functions already protect ClosetItem/BuyOrSkipAnalysis capacity
///      against a concurrent request — see cloudinary-deletion-claim.server.ts.
///      A plain "recheck then delete" read is not atomic on its own; this
///      row, read and written inside Serializable transactions on both
///      sides, is what makes the check-then-act atomic in practice.
/// resourceType/deliveryType are stored per-row, not assumed — NaiaModel
/// photos are the one asset type in this app that can legitimately be
/// either Cloudinary delivery type "private" or "authenticated" (see
/// my-naia-model.server.ts's PERMITTED_DELIVERY_TYPES), so asset identity
/// for a destroy/list call must carry its own observed type, never a
/// hardcoded default.
model PendingCloudinaryDeletion {
  id            String    @id @default(cuid())
  customerId    String
  publicId      String    @unique
  resourceType  String    @default("image")
  deliveryType  String
  /// "abandoned-upload-sweep" | "account-erasure" — which caller discovered
  /// this asset needed deleting, for operator triage.
  context       String
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  /// Set once the Cloudinary destroy call is confirmed to have succeeded
  /// (or the asset was already gone). While null, the publicId is treated
  /// as claimed/unavailable by the reservation check above.
  resolvedAt    DateTime?

  @@index([customerId])
  @@index([resolvedAt])
}

/// Audit + overlap-guard record for one run of the bounded, resumable,
/// multi-customer abandoned-upload sweep (cron or admin-triggered — never
/// the per-customer immediate sweep that runs inside account erasure, which
/// is small and synchronous by construction and doesn't need this). A
/// RUNNING row with a recent startedAt blocks a second concurrent run from
/// starting; cursorCustomerId lets a run that stopped early (time budget,
/// Cloudinary rate limit, or a per-run customer cap) resume instead of
/// restarting from the top, so there is never an uncontrolled all-customer
/// sweep in one invocation.
model CloudinarySweepRun {
  id                      String    @id @default(cuid())
  status                  String    // RUNNING | COMPLETED | FAILED
  mode                    String    // SCHEDULED | ADMIN
  dryRun                  Boolean   @default(true)
  startedAt               DateTime  @default(now())
  finishedAt              DateTime?
  cursorCustomerId        String?
  customersChecked        Int       @default(0)
  assetsChecked           Int       @default(0)
  assetsDeleted           Int       @default(0)
  assetsSkippedRecent     Int       @default(0)
  assetsSkippedReferenced Int       @default(0)
  failures                Int       @default(0)
  stoppedReason           String?   // TIME_BUDGET | CUSTOMER_CAP | RATE_LIMIT | COMPLETED_ALL | ERROR

  @@index([status, startedAt])
}

/// A point-in-time reading of the wardrobe, so "what changed?" has a before.
/// Without this there is nothing honest to compare a new piece against.
model WardrobeSnapshot {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  takenAt     DateTime @default(now())
  /// Pieces in the Closet when this was taken — the denominator.
  closetCount Int
  /// Register states, effective depth and open gaps. Shape owned by
  /// wardrobe-snapshot.server.ts; read only by the diff that produces
  /// "what changed", never re-interpreted as fresh analysis.
  summary     Json

  @@index([customerId, takenAt])
}

// ============================================
// BILLING — PHASE 1 (schema only)
//
// Scope: additive data model for the paid-membership lifecycle approved
// 2026-11-03. No payment collection, no real provider calls, no activation
// path, and ENTITLEMENT_ENFORCEMENT is untouched — Customer.membershipStatus
// remains the single value every existing checkEntitlement/reserve* call
// reads, unchanged in shape. These models exist to receive that data once
// Phase 3 (provider integration) builds the checkout/webhook code that
// writes to them; nothing here is wired into any route yet.
//
// LAUNCH BLOCKER, not resolved here: this branch does not include the
// Phase 2 privacy-remediation work (customer-privacy.server.ts /
// eraseCustomerData) — it lives on a separate, as-yet-unmerged branch. The
// onDelete: Restrict choices below are the correct structural stance
// regardless (financial records need a deliberate retention policy, not a
// silent cascade-delete), but retention and erasure MUST be explicitly
// reconciled — before any real billing launch, not as an afterthought —
// once the two lineages merge. Until that reconciliation lands,
// eraseCustomerData's unconditional prisma.customer.delete() will throw
// (not silently misbehave) for any customer who has real billing history,
// which is the deliberately loud, safe failure mode in the meantime.
// ============================================

enum SubscriptionStatus {
  INCOMPLETE // Checkout started, no confirmed payment yet. Customer.membershipStatus
             // MUST stay NONE for a subscription in this state — activation is gated
             // on a payment-confirmation webhook, never on checkout/session creation.
  ACTIVE
  PAST_DUE   // A renewal payment failed; access is retained during the approved
             // 7-day grace period (coordinated with the provider's own retry
             // schedule) before falling through to EXPIRED.
  CANCELED   // Customer-initiated. Per product decision, access is retained until
             // currentPeriodEnd — cancellation sets cancelAtPeriodEnd immediately,
             // but status only moves to CANCELED once the provider confirms the
             // subscription has actually ended.
  EXPIRED    // PAST_DUE grace period exhausted with no resolution, or a non-renewed
             // subscription's period has simply ended.
}

enum BillingPlanType {
  MONTHLY
  ANNUAL // Pays once for 12 months; usage still resets on a monthly cadence
         // anchored to the subscription's own start date, not the calendar
         // month and not the full annual period — see usage-window design.
}

// One row per subscription object's current lifecycle state — mutated in
// place as webhooks arrive, mirroring how a provider's own subscription
// object is itself a single long-lived, mutable record (Stripe subscriptions
// keep one id across status changes). This model answers "what is this
// customer entitled to right now." For "what did this customer actually pay,
// and when" — the historical, immutable ledger — see BillingTransaction.
model Subscription {
  id         String   @id @default(cuid())
  customerId String
  // Deliberately NOT Cascade: a financial/billing record must not be
  // silently destroyed by a customer-erasure flow — UAE tax law and standard
  // financial record-keeping practice require retention independent of a
  // data-subject erasure request (a well-established tension in data-
  // protection frameworks generally, not unique to this app). Restrict makes
  // that conflict loud and structural: Customer.delete() will throw if any
  // Subscription row still references it, forcing a deliberate, billing-
  // aware erasure path to be built (anonymize what erasure requires while
  // retaining what the law requires) rather than silently cascading away
  // financial records or silently blocking erasure for everyone. See the
  // module header above re: the still-separate Phase 2 privacy branch.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status   SubscriptionStatus
  planType BillingPlanType

  provider               String  // "stripe" — named explicitly; not assumed to be the only provider forever.
  providerCustomerId     String? // Null until the provider-side customer object exists (created at first checkout).
  providerSubscriptionId String? @unique // Null until the provider confirms the subscription object.

  // Nullable: genuinely unknown while INCOMPLETE — there is no period until
  // a payment has actually succeeded. Non-null from the first ACTIVE
  // confirmation onward. Left at their last known values on CANCELED/
  // EXPIRED — never cleared — so "what period was this customer last paid
  // through" stays answerable for support and audit.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  endedAt           DateTime?

  // When this subscription MOST RECENTLY entered PAST_DUE (set on that
  // transition, cleared back to null on any transition out of PAST_DUE —
  // to ACTIVE, CANCELED, or EXPIRED). Exists to enforce the approved 7-day
  // grace period (see the PAST_DUE enum comment above) INDEPENDENTLY of
  // whatever retry/dunning schedule the Stripe account happens to be
  // configured with — a subscription must never grant paid access for an
  // unbounded PAST_DUE window just because the provider's own retries
  // haven't given up yet. Phase 3 review fix (2026-11): entitlement.
  // server.ts's getCurrentSubscription treats a PAST_DUE row whose grace
  // period has elapsed exactly as if it were EXPIRED, regardless of what
  // the stored status column still says.
  pastDueSince DateTime?

  // Out-of-order webhook / reconciliation guard. Providers do not guarantee
  // webhook delivery order — a redelivered or delayed event must never
  // overwrite newer state with older data. The processing rule this field
  // supports: never trust a webhook payload's values directly; re-fetch the
  // authoritative subscription object from the provider, compare ITS event
  // timestamp against providerSyncedAt, and only apply + advance this field
  // if the incoming state is actually newer. The same rule applies equally
  // to a periodic reconciliation pass re-fetching from the provider, not
  // just to live webhook delivery — one staleness guard serves both.
  providerSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingTransactions BillingTransaction[]
  accessRevocations   AccessRevocation[]

  @@index([customerId])
  @@index([providerSubscriptionId])
  @@index([providerCustomerId])
}

enum BillingTransactionType {
  SUBSCRIPTION_INITIAL
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_REFUND
  ADDON_STYLEME_BOOST
  ADDON_VTO_BOOST
  ADDON_CLOSET_EXPANSION
}

enum BillingTransactionStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

// The immutable billing-history ledger — one row per actual financial event
// (initial subscription payment, each renewal charge, each add-on purchase,
// each refund). This, not Subscription, is the source for "customer billing
// history" and for reconciling what was paid against what was/is entitled —
// Subscription only ever holds current state, so historical renewal amounts
// and dates are not reconstructable from it alone.
model BillingTransaction {
  id         String   @id @default(cuid())
  customerId String
  // Same Restrict rationale as Subscription above — this IS the financial
  // record retention law and reconciliation require; it must survive a
  // customer-erasure flow or that flow must be updated to handle it
  // deliberately, never cascade through it silently.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Required, not nullable: every transaction type this model records
  // (initial payment, renewal, refund, every add-on kind) happens in the
  // context of a Subscription that already exists by the time the
  // transaction is recorded — the Subscription row is always created at
  // checkout-initiation, before any payment can confirm. Restrict, not
  // SetNull: a financial ledger row must never have its link to the
  // subscription it funded silently dropped — that link is itself part of
  // the audit trail reconciliation requires. Restrict makes "delete a
  // Subscription that still has transactions" a deliberate, blocked
  // decision instead of a silent, destructive one.
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  type   BillingTransactionType
  status BillingTransactionStatus

  amount   Int    // Minor currency units (fils) — avoids float rounding on money. AED 39.00 = 3900.
  currency String @default("AED")

  provider              String
  providerTransactionId String? @unique

  // Set only on a SUBSCRIPTION_REFUND row — the id of the ORIGINAL
  // BillingTransaction this refund refunds (never another refund's own
  // row). A loose self-reference, not a Prisma relation: a subscription
  // can have multiple distinct original payments (initial + each
  // renewal), each separately, independently refundable, so "how much of
  // THIS specific payment has been refunded so far" must be computed by
  // summing only the rows pointing at that one payment — never by summing
  // every refund on the subscription, which would conflate an old,
  // already-superseded period's refund with the current period's.
  refundsTransactionId String?

  // Add-on fields — null for SUBSCRIPTION_* transaction types.
  // addonQuantityGranted: e.g. 5 for a StyleMe boost, 10 for a VTO boost, 250
  // for a Closet expansion.
  // addonAppliesToPeriodStart/End: the EXACT usage-period window a StyleMe/
  // VTO top-up is valid for (one-time, current-period-only, per product
  // decision) — compared for an exact match against the customer's current
  // resolved usage window, not a loose date-range overlap. Deliberately
  // left null for ADDON_CLOSET_EXPANSION: Closet capacity is cumulative and
  // permanent while membership is active, not tied to a single usage
  // window (per product decision) — and critically, an expired/lapsed
  // membership must NEVER trigger deleting existing Closet items just
  // because the effective limit may drop; this model holds no mechanism
  // that could do that, deliberately, and none should be added later
  // without a conscious product decision to allow data loss.
  addonQuantityGranted      Int?
  addonAppliesToPeriodStart DateTime?
  addonAppliesToPeriodEnd   DateTime?

  // Which subscription period THIS specific payment funded — captured as a
  // point-in-time snapshot of Subscription.currentPeriodStart/End at the
  // moment this row is created, deliberately NOT a live re-read of the
  // Subscription row later. The Subscription's own period fields are
  // overwritten on every renewal, so by the time a refund/dispute arrives
  // for an OLD transaction, Subscription.currentPeriodStart/End has already
  // moved on and no longer answers "what period did THIS payment cover" —
  // only this frozen snapshot can. This is what lets a refund of an old,
  // already-superseded invoice be correctly distinguished from a refund of
  // the customer's PRESENT entitlement (see AccessRevocation below) without
  // comparing against a moving target.
  //
  // Why not Stripe's own Invoice.lines[].period (the more "authoritative"
  // source one might reach for): verified directly against Stripe's current
  // API reference that as of API version 2025-03-31.basil (our pinned
  // version, 2026-10-28.endive, is later than this), PaymentIntent.invoice
  // and the top-level Invoice.subscription field were BOTH removed (see
  // https://docs.stripe.com/changelog/basil/2025-03-31/adds-new-parent-field-to-invoicing-objects).
  // There is no direct "fetch the Invoice for this PaymentIntent" lookup
  // left in this API version — only an Invoice-side expansion
  // (invoice.payments.data.payment.payment_intent), which is a list-and-
  // filter operation, not something this design relies on without first
  // proving its mechanics live. This snapshot is the verified-safe
  // alternative: it never drifts, and it needs no additional Stripe API
  // call at refund-processing time.
  //
  // Nullable: rows created before this field existed have no snapshot.
  // That absence must be treated as "cannot safely determine the funded
  // period" — fail closed (flag for manual review), never guess.
  fundedPeriodStart DateTime?
  fundedPeriodEnd   DateTime?

  occurredAt DateTime // The provider's own event time for this transaction — not our local processing time.
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([subscriptionId])
  @@index([refundsTransactionId])
}

// A real Stripe dispute (not a mere "warning" pre-dispute signal — see
// mapStripeDisputeStatus in webhook-handler.server.ts for how Stripe's full
// status enum, including the warning_*/appeal_*/prevented values verified
// live against the current API reference, collapses into this simplified
// set). One row per Stripe Dispute object, kept in sync across its whole
// lifecycle (created -> possibly needs_response/under_review/appeal_* ->
// won/lost/prevented), never deleted once created — it is itself part of
// the financial/audit record Founder Decision 16 requires.
model Dispute {
  id         String @id @default(cuid())
  customerId String
  // Same financial-record-retention rationale as Subscription/
  // BillingTransaction above — a dispute record must survive customer
  // erasure, not cascade away with it.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Loose reference, not Restrict/Cascade: a dispute can arrive (and does
  // arrive, per Stripe's own delivery-order guarantees — or lack thereof)
  // before this app has any BillingTransaction/Subscription row to attach
  // it to yet. subscriptionId is filled in once/if association succeeds;
  // left null otherwise rather than blocking the Dispute row's own
  // creation on an association this file's own code may need to retry.
  subscriptionId String?

  providerDisputeId String @unique

  status DisputeStatus

  amount   Int
  currency String @default("AED")

  // The provider's own event time for the MOST RECENTLY APPLIED status
  // transition — not local processing time. Compared against each new
  // incoming event's own timestamp (and, for a same-second tie, against
  // disputeStatusFinalityRank) before applying, so a stale/out-of-order
  // redelivery can never un-apply a later, more authoritative state. Same
  // staleness-guard shape as Subscription.providerSyncedAt.
  lastEventAt           DateTime
  lastEventFinalityRank Int

  occurredAt DateTime // dispute.created's own event time — when the dispute first existed, never overwritten after.
  resolvedAt DateTime?

  // Loose reference to the AdminAuditLog row recording an admin override
  // applied to the AccessRevocation this dispute caused, if any — see
  // AccessRevocation.overrideAuditLogId below for the actual override
  // target; carried here too purely for convenient lookup from the dispute
  // side without a join.
  overrideAuditLogId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([subscriptionId])
}

enum DisputeStatus {
  PENDING // needs_response, under_review, appeal_needs_response, appeal_under_review
  WON
  LOST
  PREVENTED // Stripe's "prevented" status (API 2025-08-27.basil+) — the
            // dispute-prevention network caught it before it became a
            // formal chargeback; funds never left. Kept distinct from WON
            // so the audit trail doesn't misrepresent "never formally
            // disputed" as "disputed and won."
}

// The correctness source of truth for "is this subscription's access
// currently revoked, and why" — Founder Decision 16's full/partial-refund
// and dispute-outcome rules, applied per-reason rather than as a single
// flat flag, specifically so restoring ONE reason (e.g. a dispute later
// resolving WON) can never silently clear an INDEPENDENT reason (e.g. a
// separate refund) that is also still active. Access is revoked for a
// subscription iff at least one row exists for it with resolvedAt: null —
// queried directly (an indexed lookup), not cached as a denormalized
// boolean on Subscription, because safely maintaining such a flag under
// concurrent webhook deliveries (two independent revocation-causing events
// landing near-simultaneously) would require its own proven-atomic update
// path that this implementation does not yet have; the directly-indexed
// query is correct by construction instead.
model AccessRevocation {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  reason AccessRevocationReason

  // Exactly one of these is set, matching `reason` — the BillingTransaction
  // (a refund) that caused this row when reason = REFUND, or the Dispute
  // that caused it when reason = DISPUTE_LOST. Loose references (not
  // Restrict-relations) so resolving/deleting either source model's own
  // lifecycle never needs to coordinate with this table's own constraints.
  sourceTransactionId String?
  sourceDisputeId     String?

  createdAt DateTime @default(now())

  // Null = still actively revoking access. Set when this SPECIFIC reason
  // no longer applies (e.g. this exact dispute resolved WON, or an admin
  // override was applied to this exact row) — never touches any OTHER
  // row for the same subscription.
  resolvedAt     DateTime?
  resolvedReason String? // e.g. "dispute_won", "dispute_prevented", "admin_override"

  // Set only when resolvedReason = "admin_override" — the AdminAuditLog
  // row recording who authorized the override, their stated reason, and
  // when (Founder Decision 16's override-record requirement: authorization
  // + reason + references + timestamp + audit record). Loose reference,
  // same rationale as elsewhere in this file.
  overrideAuditLogId String?

  @@index([subscriptionId, resolvedAt])
}

enum AccessRevocationReason {
  REFUND
  DISPUTE_LOST
}

// Durable, queryable manual-review obligation (2026-11-13 correctness
// review) — replaces relying on captureFailure alone (console.error only,
// see error-tracking.server.ts's own header) as the SOLE record of "a
// refund/dispute's funded period could not be established, so access was
// correctly NOT auto-revoked, but a human needs to look at it." An open
// (resolvedAt: null) row IS the obligation; nothing else tracks it, so a
// webhook that returns ok:true for one of these cases (deliberately, since
// retrying would never fix a permanently-missing historical field) can
// never let the obligation disappear into log retention.
//
// Loose references only (no Restrict relations), same rationale as
// AccessRevocation.sourceTransactionId/sourceDisputeId above — this table's
// lifecycle must never coordinate with BillingTransaction/Dispute's own.
model ManualReviewFlag {
  id String @id @default(cuid())

  // e.g. "funded_period_unknown" — a short, stable machine key, not a
  // free-text message (that lives in `detail`).
  category       String
  subscriptionId String?
  transactionId  String?
  disputeId      String?
  detail         Json?

  createdAt DateTime @default(now())

  // Null = still open, needs a human. Set when an admin has triaged it —
  // NOT automatically cleared just because time passed.
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedNote   String?

  @@index([resolvedAt])
  @@index([subscriptionId])
  @@index([transactionId])
}

// Idempotency ledger for provider webhook deliveries. Deliberately NOT a
// Prisma relation to Customer: this is an operational log, not customer
// data — some events may never resolve to a known customer (malformed or
// unexpected payloads), and this table must never block, or be affected by,
// customer erasure. The (provider, providerEventId) unique constraint is
// what makes processing idempotent: inserting this row and applying the
// event's side effects in the same transaction means a redelivered event
// either never gets this far (unique violation) or is a no-op in practice —
// the same pattern already used for the Shopify privacy-webhook and
// StyleMe/BuySkip/Closet quota-reservation idempotency elsewhere in this
// codebase, applied here to billing.

// Closes a genuine concurrency gap the pre-existing "does a non-terminal
// Subscription row already exist" check (api.billing-checkout.tsx) cannot:
// that check only ever sees something once an EARLIER checkout attempt's
// webhook has landed, which can be minutes away. Two requests racing BEFORE
// any Subscription row exists — two tabs, a double-click outside the 5-
// minute idempotency-key bucket, two different plan types — each sailed
// straight through that check and could mint a separate, independently-
// billed Stripe subscription. customerId's @@unique constraint is the
// actual atomicity guarantee: only one reservation row can exist per
// customer at the database level, so the SECOND of two truly concurrent
// insert attempts always fails with P2002, not a race-prone read-then-write.
//
// One row per customer, not a history — deleted (not soft-closed) the
// moment its outcome is known, by whichever of three paths resolves first:
//   1. checkout.session.completed / .async_payment_succeeded /
//      .async_payment_failed (webhook-handler.server.ts) — the attempt
//      reached a real outcome; a Subscription row now exists (or definitively
//      failed to), so the Subscription-based check above takes over.
//   2. checkout.session.expired (webhook-handler.server.ts) — the customer
//      abandoned the Stripe-hosted checkout page without paying; Stripe
//      itself fires this once the session's own expires_at passes. This is
//      the ONLY path that fires when the OTHER two never will, since no
//      Subscription row was ever created for an abandoned attempt.
//   3. expiresAt fallback (checkout-reservation.server.ts, checked on the
//      NEXT checkout attempt) — defense-in-depth in case Stripe's own
//      .expired webhook was ever missed; never the primary mechanism.
// expiresAt is always set to match the Stripe Checkout Session's own
// expires_at (30 minutes — Stripe's enforced minimum), so both cleanup
// paths agree on when an attempt counts as abandoned.
model CheckoutReservation {
  id         String @id @default(cuid())
  customerId String @unique

  planType                  BillingPlanType
  providerCheckoutSessionId String? // Set once Stripe confirms session creation; null for the brief window between reserving and that response.

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ProcessedWebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  // The provider's own event timestamp — distinct from processedAt (our
  // local processing time). Compared against Subscription.providerSyncedAt
  // to reject a stale, out-of-order redelivery rather than apply it blindly.
  eventCreatedAt DateTime
  processedAt    DateTime @default(now())

  // Loose reference only — see the no-relation rationale above.
  customerId String?

  payload Json? // Raw event payload, for reconciliation/debugging.

  @@unique([provider, providerEventId])
  @@index([customerId])
}

// ============================================
// ONBOARDING QUIZ
// ============================================

model OnboardingProfile {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  completed  Boolean  @default(false)

  // Style Identity
  stylePersonalities  String[]  // e.g., ["classic", "romantic", "edgy"]
  styleIcons          String[]  // People whose style she admires
  favoriteColors      String[]
  avoidColors         String[]

  // Lifestyle & Context
  lifestyle           String[]  @default([])
  dressesFor          String[]  // e.g., ["work meetings", "date nights", "school runs"]
  typicalDay          String?   // Description of her typical day

  // Emotional & Aspirational
  currentMood         String?   // How she feels about her style now
  desiredFeeling      String?   // How she wants to feel when dressed
  confidenceBlockers  String[]  // What holds her back
  styleStruggles      String[]  // e.g., ["finding right fit", "mixing patterns", "accessorizing"]

  // Preferences
  comfortLevel        Int?      // 1-10 scale for fashion risk
  budgetRange         String?   // e.g., "moderate", "investment pieces", "mix"
  shoppingHabits      String?   // How she currently shops
  helpWantedMost      String?   // Primary thing she wants help with

  // Body & Fit (optional, sensitive)
  bodyFocusAreas      String[]  // Areas she wants to highlight
  bodyAvoidAreas      String[]  // Areas she prefers to minimize
  fitPreferences      String[]  // e.g., ["loose tops", "high-waisted", "midi length"]

  // Size Information
  topSize             String?
  bottomSize          String?
  dressSize           String?
  shoeSize            String?

  // Passport Lite v1 — quiz answers
  desiredImpression   String[]  @default([])
  desiredFeelings     String[]  @default([])
  becoming            String[]  @default([])
  styleSupport        String[]  @default([])
  finalNotes          String?

  // Passport V2-B1 — shape, colour & shopping context (persist-only in B1)
  silhouette           String[]  @default([])
  structure            String?
  coveragePreferences  String[]  @default([])
  neutralVsColour      String?
  colourIntensity      String?
  printAppetite        String?
  shoppingPriorities   String[]  @default([])
  trendAppetite        String?

  // Passport V2-D — complete sizing, measurements, and body fit
  sizingSystem         String?
  shoeSizingSystem     String?   // V2-F: independent shoe sizing (uk/us/eu/other)
  height               String?
  bodyShape            String?
  bustMeasurement      String?
  waistMeasurement     String?
  hipMeasurement       String?
  measurementUnit      String?
  preferredCoverage    String?
  fitConcerns          String[]  @default([])

  // Passport Rev 6 — new fields (additive; no legacy data removed)
  currentGoal           String[]  @default([])   // mutable context; never scored
  successfulOutfitGives String[]  @default([])   // standing; future Style Memory
  dressingPreferences   String[]  @default([])   // feeds Group 2 hard-exclusion engine
  fitConcernsNote       String?                   // free-text "other" from fit screen
  profileVersion        Int?                      // null=legacy; 6=Rev 6; 7=Rev 7 confirmed

  // Passport Rev 7 — new fields (additive; no legacy data removed or rewritten).
  // stylePersonalities above is retained as read-only legacy data: the Rev 7 flow
  // never writes it. styleDirections is the canonical Rev 7 style field.
  styleExpression          String[]  @default([])  // what the user wants clothes to communicate
  explorationLevel         String?                  // how far nAia should move beyond familiar
  styleDirections          String[]  @default([])  // visual aesthetics the user is drawn to
  dressingHabits           String[]  @default([])  // behavioural context; never scored
  dressingRequirementsNote String?                  // free-text cultural/religious requirement

  // About You — contextual profile information (not used to infer style/recommendations)
  ageRange              String?
  gender                String?
  genderSelfDescription String?

  // Closet completeness. nAia analyses what has been UPLOADED, which is not
  // necessarily everything owned. Until this is answered, advice about what to
  // buy stays hedged — see wardrobe-page.ts.
  //   mostly       — this is most of what I wear
  //   still-adding — I'm still adding pieces
  closetCompleteness   String?
  closetCompletenessAt DateTime?
}

// ============================================
// DIGITAL CLOSET

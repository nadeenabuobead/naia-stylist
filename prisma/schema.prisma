  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  userAgent   String?
  // Shopify OIDC id_token from the login that created this session — kept
  // only to pass as id_token_hint to Shopify's end_session_endpoint on

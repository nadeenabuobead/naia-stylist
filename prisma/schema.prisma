// ============================================
// PHASE 4B3 — JOURNEY EVENT LOG
// ============================================

model JourneyEvent {
  id             String   @id @default(cuid())
  type           String   // JourneyEventType
  occurredAt     DateTime
  customerIdHash String   // SHA-256 prefix — never raw customerId; no FK to Customer
  sessionId      String   // styling session id or sentinel ("product-page", "unknown")
  payload        Json     // operational fields only — see journey-contract.ts

  // Batch 2 — deduplication key (null = pre-Batch-2 record, fire-and-forget)
  // Format: "<eventType>:<sourceRecordId>:v1" — unique per logical write
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([type])
  @@index([customerIdHash])
  @@index([occurredAt])
}

// ============================================
// MY NAIA MODEL — Virtual Try-On Identity
// ============================================

enum TryOnProvider {
  FASHN
}

enum TryOnJobStatus {
  CREATED
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
  TIMED_OUT
}

// One active model record per customer. Stores Cloudinary public IDs only —
// never base64, raw bytes, or permanent delivery URLs.
model NaiaModel {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Cloudinary public IDs — stored after validated upload; cleared on deletion.
  // Delivery URLs are constructed server-side via private_download API; never stored here.
  facePublicId String? // naia-wardrobe/${customerId}/... — face/upper-body
  faceVersion  String? // Cloudinary resource version (retained for reference)
  faceFormat   String? // Cloudinary file format (e.g. "jpg", "png") — needed for private_download URL
  bodyPublicId String? // naia-wardrobe/${customerId}/... — full-body try-on model
  bodyVersion  String? // Cloudinary resource version (retained for reference)
  bodyFormat   String? // Cloudinary file format for body photo
  // Delivery type used at upload time — needed for deletion signature and URL generation.
  // Always "private" for new uploads; preserved so deletion uses the correct API parameters.
  deliveryType String  @default("private")

  // Consent timestamps — created only after explicit customer submission.
  // Null means consent has not been granted (or has been withdrawn).
  photoAnalysisConsentAt DateTime?
  saveModelConsentAt     DateTime?
  consentPolicyVersion   String?

  // Body photo moderation status — PENDING until Layer 2+3 pass; APPROVED to enable VTO.
  bodyModerationStatus String?   @default("PENDING")
  bodyModerationAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tryOnJobs VirtualTryOnJob[]

  @@index([customerId])
}

// Per-generation virtual try-on job. Records per-generation consent and
// provides durable idempotency and cooldown across instances.
model VirtualTryOnJob {
  id          String     @id @default(cuid())
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  naiaModelId String?
  naiaModel   NaiaModel? @relation(fields: [naiaModelId], references: [id], onDelete: SetNull)

  productHandle String
  provider      TryOnProvider @default(FASHN)
  predictionId  String? // Set only after the provider accepts the submission

  status TryOnJobStatus @default(CREATED)

  // Per-generation consent — required for each new job; not inherited from model.
  virtualTryOnConsentAt    DateTime
  consentPolicyVersion     String
  saveTryOnResultConsentAt DateTime? // Separate, optional

  // Idempotency — unique constraint prevents duplicate chargeable submissions.
  idempotencyKey     String  @unique
  // SHA-256 fingerprint of (customerId + productHandle + bodyPublicId) for
  // near-duplicate detection even across different idempotency keys.
  requestFingerprint String?

  errorCode String? // Safe provider/customer error code — never a stack trace

  // Phase 2 (billing) — a job created for staging/QA testing of the try-on
  // pipeline itself (e.g. against FASHN's sandbox/test mode once that
  // exists), never a real customer generation. Defaults to false so every
  // existing row and every existing write path is unaffected. Every VTO
  // quota-counting query in entitlement.server.ts filters isTest: false —
  // a test job must never consume or appear to consume a real customer's
  // paid monthly allowance. No code path sets this to true yet; this field
  // exists so that one can be built (a staging fixture, a QA harness) with
  // an explicit, structural guarantee already in place, rather than relying
  // on convention to keep test traffic out of real quota counts later.
  isTest Boolean @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  lastActivityAt DateTime  @default(now()) // Drives durable per-customer cooldown

  @@index([customerId])
  @@index([customerId, status])
}

// Customer feedback on a single nAia First Read observation.
// One row per (customerId, observationKey) pair — upserted on each response.
// Provenance (type/fields/values/claim) is SERVER-GENERATED from the customer's
// current OnboardingProfile — never accepted from the browser.
model NaiaObservationFeedback {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  observationKey   String   // deterministic: "first-read-v1|{type}|{field:value pairs}"
  response         String   // "accurate" | "not-quite"
  observationType  String   // server-generated provenance
  evidenceFields   String[] // server-generated provenance
  evidenceValues   String[] // server-generated provenance
  claimText        String   // server-generated provenance
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([customerId, observationKey])
  @@index([customerId])
}

// One selfie analysis record per customer. Stores only validated style signals —
// no raw provider output, no biometric inferences, no exact measurements.
model SelfieAnalysis {
  id                String    @id @default(cuid())
  customerId        String    @unique
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  consentAt         DateTime
  /// Which consent wording was agreed to, so a future wording change can
  /// re-ask — same pattern as designResearchConsentVersion/
  /// ageConfirmationVersion. Nullable: not yet stamped by
  /// beginSelfieAnalysis (app/lib/ai/selfie-persistence.server.ts), whose
  /// signature has several existing callers/tests — threading a new
  /// parameter through is a deliberately separate follow-up, not bundled
  /// into this additive schema change.
  consentVersion    String?
  photoPublicId     String?
  photoFormat       String?
  photoDeletedAt    DateTime?
  analysisStatus    String
  analysisResult    Json?
  analysedAt        DateTime?
  analysisDeletedAt DateTime?
  analysisVersion   Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId])
}

// ============================================
// STYLE MEMORY V1 — STYLEME OUTCOME CAPTURE
// ============================================

// One outcome row per OutfitSuggestion — UPSERT semantics.
// Stores customer-reported outcome evidence only; no inference, no pattern scoring.
// sessionId is server-derived (from OutfitSuggestion.session) — never from client input.
model StyleMeOutcome {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Canonical owner — one outcome per suggestion
  suggestionId String            @unique
  suggestion   OutfitSuggestion  @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  // Denormalized for efficient querying; always server-derived
  sessionId String

  // Core outcome — stable IDs only (validated server-side)
  outcomeStatus    String    // wore-it | changed-something | didnt-wear-it
  changeTypes      String[]  @default([])  // max 5; non-empty only when outcomeStatus=changed-something
  otherChangeNote  String?   @db.Text      // max 280 chars; only when "other" in changeTypes
  goalOutcome      String?   // yes | somewhat | no; null when outcomeStatus=didnt-wear-it
  selectedDirection String?  // most-you | fresh | push-me; null when no direction shown or selected

  // QA redesign fields — additive, default empty
  whatWorked       String[]  @default([])  // positive reasons; max 3; active when wore-it/changed-something + goalOutcome=yes
  whatFeltOff      String[]  @default([])  // negative reasons; max 3; active when wore-it/changed-something + goalOutcome=somewhat/no
  didntWearReasons String[]  @default([])  // reasons for not wearing; max 3, min 1; active when didnt-wear-it
  reasonOtherNote  String?   @db.Text      // max 280 chars; for "other" in whatWorked/whatFeltOff/didntWearReasons

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([sessionId])
}

// ============================================
// TASTE EVIDENCE + STYLE TENDENCY — Phase 5D
// ============================================

model TasteEvidence {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Source identity — used for delete-and-reinsert on source record update
  source         String   // STYLEME_OUTCOME | POST_OUTFIT_REVIEW | CLOSET_RELATIONSHIP | BUYSKIP_OUTCOME
  sourceRecordId String   // ID of the originating record

  // Canonical evidence signal
  dimension String   // self-expression | comfort | formality | fit | garment-category
  value     String   // dimension-specific value (e.g. "self-expression", "too-formal", "DRESSES")
  polarity  String   // positive | negative

  // Weighted strength — clamped to [0.1, 1.0]
  strength Float

  // Optional session context for future CONTEXTUAL_PREFERENCE family (V2)
  context Json?

  // Server-generated provenance — never exposed raw to customers
  provenance Json

  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@unique([customerId, source, sourceRecordId, dimension, value, polarity])
  @@index([customerId, dimension, value])
  @@index([customerId, source])
  @@index([customerId, source, sourceRecordId])
}

model StyleTendency {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Stable identity
  observationKey String   // tendency-v1|{dimension}:{value}
  dimension      String
  value          String

  // Generation — increments when a REJECTED observation re-emerges
  generation Int @default(1)

  // Computed observation state
  dominantPolarity  String   // positive | negative
  observationFamily String   // WORKS_WELL | FRICTION
  state             String   // CANDIDATE | CONFIRMED | SUPPRESSED | REJECTED

  // Evidence accounting — recomputed on every reconcile
  wSupport         Float @default(0)
  wContradict      Float @default(0)
  wNet             Float @default(0)
  distinctRecords  Int   @default(0)
  distinctSources  Int   @default(0)
  effectiveSupport Float @default(0)

  // Post-correction tracking for re-emergence
  wSupportSinceCorrection        Float @default(0)
  distinctRecordsSinceCorrection Int   @default(0)

  lastEvidenceAt DateTime?

  // Server-generated display text
  claimText     String?
  rationaleText String?
  claimVersion  Int @default(1)

  // Customer correction — permanently preserved
  customerFeedback   String?   // accurate | not-quite
  customerFeedbackAt DateTime?

  // Optional "not-quite" context — V1 Passport Noticing UX. Additive,
  // nullable; only ever set alongside customerFeedback = "not-quite".
  // Customer feedback context only: never read as structured Taste
  // evidence, never used to rewrite Passport or any recommendation logic.
  notQuiteReason String?   // doesnt-feel-like-me | only-sometimes | depends-on-situation | used-to-be-true | something-else
  notQuiteNote   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, observationKey, generation])
  @@index([customerId, state])
  @@index([customerId, observationFamily])
  @@index([customerId, observationKey])
}

// ============================================
// nAia ADMIN — PHASE 1 FOUNDATION
// ============================================

// Preserves the full normalized AI garment-extraction result BEFORE the
// customer-precedence merge that writes to ClosetItem. One row per analysis
// run; re-analyses append a new row rather than overwriting history.
// Added: migration 20260911000000_naia_admin_foundation
model ClosetItemAnalysisSnapshot {
  id           String     @id @default(cuid())
  closetItemId String
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  // Full GarmentExtractionResult as returned by extractGarmentIntelligence()
  // BEFORE customer-precedence logic runs. Shape:
  //   { observables: GarmentObservables, matchingSignals: GarmentMatchingSignals,
  //     fieldConfidence: GarmentFieldConfidence }
  normalizedAnalysis    Json

  analysisModel         String   // e.g. "claude-haiku-4-5"
  analysisSchemaVersion String   // e.g. "1.0"
  analyzedAt            DateTime // matches ClosetItem.analyzedAt for this run

  createdAt DateTime @default(now())

  @@index([closetItemId])
}

// Stores the admin reviewer's decision for a single ClosetItem.
// The AI analysis history lives in ClosetItemAnalysisSnapshot — not here.
// overrides is a sparse JSON object: key present → admin override wins at runtime;
// key absent → fall through to current ClosetItem value.
// Added: migration 20260911000000_naia_admin_foundation
model ClosetItemAdminReview {
  id           String     @id @default(cuid())
  closetItemId String     @unique
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  // Derived by server from overrides — never set by client.
  // "unreviewed" only on record creation (default); after first save:
  //   "reviewed"   → overrides is null or {}
  //   "overridden" → overrides has ≥1 key
  reviewStatus String @default("unreviewed")

  adminNotes String? @db.Text

  // Sparse override object. Key presence (not value truthiness) determines override.
  // [] is a valid intentional override. null is valid for scalar fields.
  // Validated server-side against canonical garment vocabularies.
  overrides Json?

  // Sparse Phase 3C admin overrides: { visualWeight?, colourProfile?, intentions? }
  // Key absence = use nAia-derived value. Key presence = admin override is active.
  intelligenceOverrides Json?

  reviewedAt DateTime?
  reviewedBy String?   // admin email / identifier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// STYLEME GARMENT PROFILE — MANUAL AUDIT TAXONOMY
// ============================================
// Stores the hand-curated StyleMe garment audit taxonomy.
// Completely separate from Closet Intelligence V2 — do not modify
// Closet Intelligence fields here. Not wired to live StyleMe yet.
// Added: migration 20260921000000_styleme_garment_profile
model GarmentStyleMeProfile {
  id           String     @id @default(cuid())
  closetItemId String     @unique
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  // Admin review status: unreviewed | in-review | approved
  profileStatus String @default("unreviewed")

  // 1. Exact Slot
  exactSlot String?  // top|bottom|dress|set|outerwear|shoe|bag|accessory|jewelry

  // 2. Outfit Function
  outfitFunction String?  // base|supporting|statement|anchor|layering|finishing

  // 3. Style Family
  styleFamilyPrimary   String?  // classic|minimal|sporty|architectural|romantic|edgy|feminine|expressive
  styleFamilySecondary String?  // same values + none (optional)

  // 4. Dress Register
  dressRegister String?  // athletic|casual|elevated-casual|smart-casual|polished|dressy|evening

  // 5. Construction
  construction String?  // soft|neutral|structured|tailored|sculptural|N/A

  // 6. Fabric Behaviour (multi-select)
  fabricBehaviour String[] @default([])  // soft|fluid|crisp|rigid|stretch|sculptural|N/A

  // 7. Silhouette Character (multi-select)
  silhouetteCharacter String[] @default([])

  // 8. Visual Weight
  visualWeight String?  // light|medium|heavy

  // 9. Styling Effort
  stylingEffort String?  // easy|neutral|deliberate|high-maintenance

  // 10. Layering Behaviour
  layeringBehaviour String?  // standalone|base-under-layer|outer-layer|either|N/A

  // 11. Waist Comfort
  waistComfort String?  // elastic|drawstring|stretch|fixed|restrictive|unknown|N/A

  // 12. Statement Level
  statementLevel String?  // quiet|moderate|statement

  // Occasion fit ratings — JSON object keyed by occasion ID
  // Keys: everyday|work|dinner|date|event|night-out|family|travel|active
  // Values: "Strong"|"Acceptable"|"No"
  occasionFit Json?

  // Intention potential ratings — JSON object keyed by intention ID.
  // Keys (16): feel-like-myself|confidence|ground-me|give-structure|make-it-easy|
  //       feel-put-together|feel-attractive|give-energy|feel-softer|feel-sharper|
  //       feel-less-exposed|express-myself|
  //       feel-elevated|stand-out|feel-fun|feel-powerful
  // Values: "Strong"|"Supporting"|"None"
  //
  // The last four were added in the 2026-09 taxonomy expansion. Because this is a
  // JSON column, that required no migration and no backfill. A KEY THAT IS ABSENT
  // MEANS "not reviewed yet" and is NOT equivalent to a stored "None" — nothing
  // may write a default value for these; only a human reviewer supplies them.
  intentionPotentials Json?

  // Pairing guidance (free text)
  naturalPairings String? @db.Text
  intentionalMix  String? @db.Text
  avoidInStyleMe  String? @db.Text
  specialNotes    String? @db.Text

  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Records the admin QA decision for a complete StyleMe session.
// The unit of review is the full decision: TODAY inputs → Passport → Closet →
// anchor → candidate ranking → model/fallback → outfit → wording → outcome.
// Added: migration 20260911000000_naia_admin_foundation
model StylingSessionAdminReview {
  id               String         @id @default(cuid())
  stylingSessionId String         @unique
  stylingSession   StylingSession @relation(fields: [stylingSessionId], references: [id], onDelete: Cascade)

  // "unreviewed" | "pass" | "questionable" | "fail"
  qaStatus String @default("unreviewed")

  adminNotes String? @db.Text
  reviewedAt DateTime?
  reviewedBy String?  // admin email / identifier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Priority 5 (2026-10-19) — auditability for the internal admin portal's
/// destructive/bulk maintenance actions (currently just the two retention
/// purges — app/routes/admin.maintenance.tsx). performedBy is the admin
/// identity's email from the session (never client input, same
/// "reviewedBy" convention as StylingSessionAdminReview above).
model AdminAuditLog {
  id          String   @id @default(cuid())
  performedBy String
  action      String
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Phase 1 API rate limiting (2026-11-10) — one row per (customer, route,
/// fixed window), not one row per request. windowStart uses the same
/// floor(epoch / windowSeconds) bucketing already established in
/// api.wishlist.jsx's idempotency key, not a new convention.
///
/// Incremented via a single atomic `INSERT ... ON CONFLICT ... DO UPDATE SET
/// count = count + 1` (api-rate-limit.server.ts) — not a Serializable
/// transaction like entitlement.server.ts's reservations. Those protect a
/// low-frequency, high-stakes "do they have a slot left" decision; this
/// protects a high-frequency "are they calling too fast" counter, where
/// transaction retry overhead would itself be the kind of unnecessary load
/// this feature exists to avoid causing.
///
/// No per-request pruning (that would double the write volume this model
/// exists to minimize) — old rows are cheap to batch-delete periodically via
/// the existing admin.maintenance.tsx pattern, not inline here.
model ApiRateLimitCounter {
  id          String   @id @default(cuid())
  customerId  String
  routeKey    String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([customerId, routeKey, windowStart])
  @@index([windowStart])
}
